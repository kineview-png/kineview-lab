# Copiar a .env y rellenar. El .env real está gitignoreado.
#
# Estas dos SÍ pueden vivir en el cliente: la llave publishable solo puede
# hacer lo que las políticas RLS permitan al usuario autenticado. La llave
# secreta (sb_secret_) y la de Anthropic NUNCA entran acá — viven solo en los
# secrets de la Edge Function.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
