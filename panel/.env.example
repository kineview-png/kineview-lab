# Copiar a .env. El .env real está gitignoreado.
#
# La llave publishable puede vivir en el cliente: por sí sola no lee nada que
# las políticas RLS no le permitan al kinesiólogo que inició sesión. La llave
# secreta no entra acá nunca — solo vive en los secrets de la Edge Function.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...
